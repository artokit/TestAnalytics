{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "REST API сервиса аналитики.",
        "title": "Analytics Service API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/metrics/ltv/by-plan": {
            "get": {
                "description": "Средний LTV, число пользователей и выручка по тарифам первой подписки когорты. from/to фильтруют когорту по дате первой подписки (RFC3339)",
                "produces": [
                    "application/json"
                ],
                "summary": "LTV по тарифу первой подписки",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Начало когорты (RFC3339)",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Конец когорты (RFC3339)",
                        "name": "to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/analytics-service_internal_handlers_response.LtvByPlanResponse"
                        }
                    },
                    "304": {
                        "description": "Not Modified"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httputil.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "снимок ещё не собран",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/metrics/ltv/summary": {
            "get": {
                "description": "Среднее, медиана, общая выручка и число пользователей когорты. from/to фильтруют когорту по дате первой подписки (RFC3339)",
                "produces": [
                    "application/json"
                ],
                "summary": "Общий LTV по всем пользователям",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Начало когорты (RFC3339)",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Конец когорты (RFC3339)",
                        "name": "to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/analytics-service_internal_handlers_response.LtvSummaryResponse"
                        }
                    },
                    "304": {
                        "description": "Not Modified"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httputil.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "снимок ещё не собран",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/metrics/retention": {
            "get": {
                "description": "Условные и кумулятивные доли продлений по периодам (когорта - пользователи с первой подпиской на указанный тариф). from/to фильтруют когорту по дате первой подписки",
                "produces": [
                    "application/json"
                ],
                "summary": "Процент продлений по периодам для тарифа",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Идентификатор тарифа",
                        "name": "plan_id",
                        "in": "query",
                        "required": true
                    },
                    {
                        "minimum": 1,
                        "type": "integer",
                        "default": 12,
                        "description": "Максимальное число периодов (по умолчанию 12)",
                        "name": "max_periods",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Начало когорты (RFC3339)",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Конец когорты (RFC3339)",
                        "name": "to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/analytics-service_internal_handlers_response.RetentionResponse"
                        }
                    },
                    "304": {
                        "description": "Not Modified"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httputil.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "нет данных для тарифа",
                        "schema": {
                            "$ref": "#/definitions/httputil.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "снимок ещё не собран",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/status": {
            "get": {
                "description": "Время последнего успешного опроса источников, время следующего опроса и последняя ошибка синхронизации, если была",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Статус синхронизации",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/analytics-service_internal_handlers_response.StatusResponse"
                        }
                    }
                }
            }
        },
        "/users/by-telegram/{telegram_id}/ltv": {
            "get": {
                "description": "Пользователь: id, тариф первой подписки, LTV, число платежей и текущий статус подписки. Данные берутся из последнего снимка",
                "produces": [
                    "application/json"
                ],
                "summary": "LTV пользователя по telegram_id",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Telegram ID пользователя",
                        "name": "telegram_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/analytics-service_internal_handlers_response.UserLtvResponse"
                        }
                    },
                    "304": {
                        "description": "Not Modified"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httputil.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/httputil.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "снимок ещё не собран",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "analytics-service_internal_handlers_response.LtvByPlanResponse": {
            "type": "object",
            "properties": {
                "data_as_of": {
                    "type": "string"
                },
                "plans": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/analytics-service_internal_handlers_response.PlanLtv"
                    }
                }
            }
        },
        "analytics-service_internal_handlers_response.LtvSummaryMetrics": {
            "type": "object",
            "properties": {
                "avg_ltv": {
                    "type": "integer"
                },
                "median_ltv": {
                    "type": "integer"
                },
                "total_revenue": {
                    "type": "integer"
                },
                "users": {
                    "type": "integer"
                }
            }
        },
        "analytics-service_internal_handlers_response.LtvSummaryResponse": {
            "type": "object",
            "properties": {
                "data_as_of": {
                    "type": "string"
                },
                "metrics": {
                    "$ref": "#/definitions/analytics-service_internal_handlers_response.LtvSummaryMetrics"
                }
            }
        },
        "analytics-service_internal_handlers_response.PlanLtv": {
            "type": "object",
            "properties": {
                "avg_ltv": {
                    "type": "integer"
                },
                "plan_id": {
                    "type": "integer"
                },
                "total_revenue": {
                    "type": "integer"
                },
                "users": {
                    "type": "integer"
                }
            }
        },
        "analytics-service_internal_handlers_response.RetentionPeriod": {
            "type": "object",
            "properties": {
                "cumulative_rate": {
                    "type": "number"
                },
                "eligible": {
                    "type": "integer"
                },
                "period": {
                    "type": "integer"
                },
                "rate": {
                    "type": "number"
                },
                "renewed": {
                    "type": "integer"
                }
            }
        },
        "analytics-service_internal_handlers_response.RetentionResponse": {
            "type": "object",
            "properties": {
                "cohort_size": {
                    "type": "integer"
                },
                "data_as_of": {
                    "type": "string"
                },
                "periods": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/analytics-service_internal_handlers_response.RetentionPeriod"
                    }
                },
                "plan_id": {
                    "type": "integer"
                }
            }
        },
        "analytics-service_internal_handlers_response.StatusResponse": {
            "type": "object",
            "properties": {
                "last_poll": {
                    "type": "string"
                },
                "last_sync_err": {
                    "type": "string"
                },
                "next_poll": {
                    "type": "string"
                },
                "ready": {
                    "type": "boolean"
                }
            }
        },
        "analytics-service_internal_handlers_response.UserLtvResponse": {
            "type": "object",
            "properties": {
                "current_status": {
                    "type": "string"
                },
                "first_plan_id": {
                    "type": "integer"
                },
                "ltv": {
                    "type": "integer"
                },
                "payments_count": {
                    "type": "integer"
                },
                "telegram_id": {
                    "type": "integer"
                },
                "user_id": {
                    "type": "string"
                }
            }
        },
        "httputil.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        }
    }
}