# Тестовое окружение seeder-service (пример). Не коммитить реальные секреты.

# Seed для детерминированной генерации данных
SEED=42

# Сколько пользователей генерировать
SEED_USERS=10000

# Размер батча при вставке (строк)
SEED_BATCH_SIZE=500

# DSN подключения к Postgres (структурно как в users-service/.config)
DATABASE_DSN=user=postgres password=postgres host=localhost port=5432 dbname=postgres sslmode=disable

# Если таблица уже заполнена: FORCE=1 -> TRUNCATE и залить заново
# FORCE=1
