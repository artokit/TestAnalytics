# --- Postgres (используются docker compose и сборка DSN в shared/config) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=users-service
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Имена баз данных сервисов ---
USERS_DB_NAME=users
PAYMENTS_DB_NAME=payments-service
SUBSCRIPTIONS_DB_NAME=subscriptions-service

# --- Адреса и порты HTTP-серверов ---
USERS_ADDRESS=127.0.0.1
USERS_PORT=8002
PAYMENTS_ADDRESS=127.0.0.1
PAYMENTS_PORT=8003
SUBSCRIPTIONS_ADDRESS=127.0.0.1
SUBSCRIPTIONS_PORT=8001
ANALYTICS_ADDRESS=127.0.0.1
ANALYTICS_PORT=8004

# --- Redis для analytics-service ---
REDIS_ADDRESS=127.0.0.1:6379

# --- Синхронизация analytics-service с другими сервисами ---
SYNC_INTERVAL=10s
SYNC_USERS_URL=http://127.0.0.1:8002
SYNC_PAYMENTS_URL=http://127.0.0.1:8003
SYNC_SUBSCRIPTIONS_URL=http://127.0.0.1:8001

# --- seeder-service ---
# Seed для детерминированной генерации данных
SEED=100
# Сколько пользователей генерировать
SEED_USERS=10000
# Размер батча при вставке (строк), от 1 до 4096
SEED_BATCH_SIZE=500
# Глубина истории платежей в месяцах, от 18 до 24
SEED_HISTORY_MONTHS=24
# Если таблицы уже заполнены: FORCE=1 -> TRUNCATE и залить заново
FORCE=0
