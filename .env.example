# Скопировать на сервер как .env в корень проекта (рядом с docker-compose.yaml),
# заполнить значения и НЕ коммитить (уже в .gitignore).

# PostgreSQL (docker-compose.yaml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# seeder-service
SEED=42
SEED_USERS=10000
SEED_BATCH_SIZE=500
FORCE=0

# analytics-service
SYNC_INTERVAL=10m
